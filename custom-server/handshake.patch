+// Allow a signing public key during migration without dropping the existing access key.
+pub(crate) fn key_matches(client: &str, configured: &str) -> bool {
+    static ADDITIONAL: once_cell::sync::Lazy<Option<String>> = once_cell::sync::Lazy::new(|| {
+        std::env::var("RUSTDESK_ADDITIONAL_KEY").ok().filter(|s| {
+            !s.is_empty() && base64::decode(s).map(|b| b.len() == 32).unwrap_or(false)
+        })
+    });
+    configured.is_empty() || client == configured || ADDITIONAL.as_deref() == Some(client)
+}
